// Settings for the Worker. Comments are allowed in this file.
// Nothing secret ever goes here: this file is public. Secrets live in
// Cloudflare's secret store and are set in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workbench",
  "main": "src/index.ts",

  // Which version of the Workers runtime rules this code was written against.
  "compatibility_date": "2026-11-11",

  // The Worker's public address. Cloudflare creates the DNS record for
  // api.kyletebo.com on the first deploy. The free workers.dev address is
  // switched off so there is one front door to guard, not two.
  "routes": [{ "pattern": "api.kyletebo.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  // Non-secret settings the code can read.
  "vars": {
    // The one website allowed to call this Worker from a browser. An exact match:
    // www.kyletebo.com is not listed because it redirects to this address.
    "ALLOWED_ORIGIN": "https://kyletebo.com",

    // The master switch for model calls. While this is "false" the Tells
    // Checker runs its free rules only and the paid key is never used. It
    // stays "false" until the spending guardrails (plan step 1.10) are built.
    "MODEL_ENABLED": "false",

    // Which model the Tells Checker asks for. Changing model is a change to
    // this line and nothing else.
    "TELLS_CHECKER_MODEL": "claude-haiku-5-5"
  },

  // Secrets the code expects. Names only: the values are set in the
  // Cloudflare dashboard and never appear in this repository.
  "secrets": { "required": ["MODEL_API_KEY"] },

  // Lets the code read a prompt file (prompts/) as plain text.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],

  // Logging. The privacy rule is that logs hold counts, cost and speed only.
  // Cloudflare's automatic per-request logs and traces record far more than
  // that: each visitor's IP address, city, postcode and browser, plus the full
  // address requested. So both are switched off. What can still be stored is
  // lines this code writes on purpose, which must be metadata only, and errors
  // the code throws, which is why src/http.ts catches every error and logs a
  // fixed line. Query strings are also stripped as a second safety net.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
